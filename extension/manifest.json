{
  "manifest_version": 3,
  "name": "Dev Authenticator",
  "version": "1.1.0",
  "description": "Live 2FA codes and one-click fill from your dev database or an encrypted personal vault.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Dev Authenticator",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Open Dev Authenticator"
    },
    "fill-current-site": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill and verify the 2FA code for this site"
    }
  },
  "icons": {
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
